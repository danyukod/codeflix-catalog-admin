@baseUrl = http://localhost:8080
@categoryId = 453b23f6-806e-4aa6-98c1-d1f2894dc207

### Criar categoria
POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Ação",
  "description": "Filmes e séries de ação",
  "is_active": true
}

### Listar categorias
GET {{baseUrl}}/categories
Accept: application/json

### Listar categorias com filtros
GET {{baseUrl}}/categories?page=1&per_page=10&terms=action&sort=name&direction=asc
Accept: application/json

### Buscar categoria por ID
GET {{baseUrl}}/categories/{{categoryId}}
Accept: application/json

### Atualizar categoria
PUT {{baseUrl}}/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Ação atualizada",
  "description": "Descrição atualizada",
  "is_active": true
}

### Atualizar parcialmente
PATCH {{baseUrl}}/categories/{{categoryId}}
Content-Type: application/json

{
  "name": "Ação modificada"
}

### Excluir categoria
DELETE {{baseUrl}}/categories/{{categoryId}}
